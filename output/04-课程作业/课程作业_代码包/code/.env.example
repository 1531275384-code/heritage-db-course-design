# =============================================================================
#  环境配置模板
#
#  用法：复制成 .env，按你的实际环境改值。程序启动时会自动读取。
#      cp .env.example .env
#
#  优先级：环境变量 > .env 文件 > 代码内默认值
# =============================================================================

# ---------------------------------------------------------------- 数据库
# 用 docker compose 起的库就是下面这套默认值，不用改
ICH_DB_HOST=127.0.0.1
ICH_DB_PORT=5432
ICH_DB_NAME=ich_heritage
ICH_DB_USER=postgres
ICH_DB_PASSWORD=postgres

# 连接池（演示环境不用改；生产按并发压测调）
ICH_DB_POOL_MIN=2
ICH_DB_POOL_MAX=10

# ---------------------------------------------------------------- 运行模式
# auto : 先试数据库，连不上自动降级为演示模式（默认，最友好）
# 1    : 强制演示模式（内存存储，完全不碰数据库）
# 0    : 强制真实数据库，连不上直接报错不降级（验收 / 生产用这个）
ICH_DEMO_MODE=auto

# ---------------------------------------------------------------- 鉴权
# ⚠️ 生产必须换成随机长串，例如：python -c "import secrets;print(secrets.token_hex(32))"
ICH_JWT_SECRET=dev-only-secret-change-me-in-production
ICH_JWT_EXPIRE_MINUTES=720

# ---------------------------------------------------------------- AI 特征
# auto    : 依次尝试 clip → resnet → builtin
# clip    : open_clip / transformers 的 CLIP ViT-B/32（需装 requirements-deep.txt）
# resnet  : torchvision ResNet-50 取深层特征后降维
# builtin : 纯 numpy（HOG + HSV + Laplacian），无需 torch，512 维，可复现
ICH_FEATURE_BACKEND=auto
ICH_TOPK=5

# 分级阈值：相似度 ≥ ICH_SIM_PUBLIC 判为「公有母题」
#           落在 [ICH_SIM_DERIVED, ICH_SIM_PUBLIC) 判为「改编衍生」
#           低于 ICH_SIM_DERIVED 判为「原创」
# 这两个数由 tests/tune_weights.py 标定得出，改动前请先读 README §11
ICH_SIM_PUBLIC=0.92
ICH_SIM_DERIVED=0.80

# ---------------------------------------------------------------- 上传
ICH_MAX_UPLOAD_MB=20
# ICH_UPLOAD_DIR=data/uploads

# ---------------------------------------------------------------- 日志
# DEBUG / INFO / WARNING / ERROR
ICH_LOG_LEVEL=INFO
